# @galley/proxy configuration. Copy to `.env` and fill in. NEVER commit `.env`.
#
# The proxy forwards to NAMED upstreams only (no client-supplied URLs → no SSRF).
# Each upstream is a triple: URL + auth header name + key. The client selects one
# by id via the `x-galley-upstream` header (see @galley/shared/proxy.ts).

# Port the proxy listens on.
PORT=8787

# Comma-separated list of allowed browser origins for CORS (the web app).
ALLOWED_ORIGINS=http://localhost:5173

# --- Upstreams (id => url + auth) -------------------------------------------
# Cloud providers: keep the API key off the browser by injecting it here.
# Pattern: UPSTREAM_<ID>_URL / UPSTREAM_<ID>_AUTH_HEADER / UPSTREAM_<ID>_KEY
#
# A LOCAL-MACHINE Ollama needs no proxy — point the browser straight at
# http://localhost:11434/v1 in `direct` mode (set OLLAMA_ORIGINS for CORS).
# But a SERVER/CLUSTER Ollama reached by a DEPLOYED (HTTPS) Galley DOES belong
# here: a direct browser call would fail on CORS + mixed-content, so add it as a
# KEYLESS upstream (leave UPSTREAM_OLLAMA_KEY unset) and select it by id from a
# `proxy`-mode Ollama provider. The hop is server-to-server, so the cluster
# endpoint never needs public exposure:
#   UPSTREAM_OLLAMA_URL=http://ollama.<namespace>.svc.cluster.local:11434/v1

UPSTREAM_OPENAI_URL=https://api.openai.com/v1
UPSTREAM_OPENAI_AUTH_HEADER=Authorization
UPSTREAM_OPENAI_KEY=Bearer sk-REPLACE_ME

UPSTREAM_ANTHROPIC_URL=https://api.anthropic.com/v1
UPSTREAM_ANTHROPIC_AUTH_HEADER=x-api-key
UPSTREAM_ANTHROPIC_KEY=REPLACE_ME
