{
  "name": "@galley/sync",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Collaboration sync server (ADR-0008): a thin, doc-holding y-websocket relay for @galley/collab peers. Self-hostable / localhost by default. No auth, no persistence yet.",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@galley/auth": "workspace:*",
    "@galley/collab": "workspace:*",
    "@galley/persistence": "workspace:*",
    "@galley/shared": "workspace:*",
    "lib0": "^0.2.117",
    "tsx": "^4.19.0",
    "ws": "^8.18.0",
    "y-protocols": "^1.0.6",
    "yjs": "^13.6.0"
  },
  "devDependencies": {
    "@types/node": "^20.16.0",
    "@types/ws": "^8.5.0"
  }
}
