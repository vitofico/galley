{
  "name": "@galley/mcp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Galley's MCP servers. The local bridge (ADR-0020): a stdio kernel an agent spawns on the person's machine, paired with a Galley tab. The hosted connector (ADR-0033): an HTTP endpoint on a signed-in deployment that works with no tab open.",
  "main": "./src/index.ts",
  "bin": {
    "galley-mcp": "./bin/galley-mcp.mjs"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start:hosted": "tsx src/hosted/main.ts"
  },
  "dependencies": {
    "@galley/agent": "workspace:*",
    "@galley/auth": "workspace:*",
    "@galley/collab": "workspace:*",
    "@galley/persistence": "workspace:*",
    "@galley/shared": "workspace:*",
    "@hono/node-server": "^1.13.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "hono": "^4.12.25",
    "tsx": "^4.19.0",
    "ws": "^8.18.0",
    "yjs": "^13.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.16.0",
    "@types/ws": "^8.5.0"
  }
}
