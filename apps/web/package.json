{
  "name": "@galley/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Galley web app: editor, live preview, agent panel, diff review UI.",
  "scripts": {
    "copy-wasm": "node scripts/copy-wasm.mjs",
    "dev": "pnpm copy-wasm && vite",
    "build": "pnpm copy-wasm && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "e2e": "playwright test --project=chromium",
    "e2e:cross": "playwright test --project=firefox --project=webkit"
  },
  "dependencies": {
    "@galley/shared": "workspace:*",
    "@galley/compiler": "workspace:*",
    "@galley/agent": "workspace:*",
    "@galley/collab": "workspace:*",
    "@galley/persistence": "workspace:*",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/language": "^6.10.0",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "^6.4.0",
    "@codemirror/view": "^6.34.0",
    "@lezer/highlight": "^1.2.0",
    "diff": "^5.2.0",
    "lib0": "^0.2.117",
    "y-codemirror.next": "^0.3.5",
    "y-indexeddb": "^9.0.12",
    "y-protocols": "^1.0.6",
    "yjs": "^13.6.0",
    "@myriaddreamin/typst-ts-renderer": "0.7.0",
    "@myriaddreamin/typst-ts-web-compiler": "0.7.0",
    "codemirror": "^6.0.1",
    "dompurify": "^3.2.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@types/diff": "^5.2.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  }
}
