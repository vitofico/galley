# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
*.tsbuildinfo

# @galley/agent-client release bundle (scripts/bundle.mjs default --outdir).
# The vendored artifact is reviewed/committed in the CONSUMER repo, never here.
packages/agent-client/bundle-dist/

# Vite
apps/web/dist/
.vite/
# Locally-staged typst runtime assets (regenerated by apps/web/scripts/copy-wasm.mjs)
apps/web/public/*.wasm
apps/web/public/fonts/

# Playwright e2e artifacts
apps/web/test-results/
apps/web/playwright-report/
apps/web/.playwright/
apps/web/.ui-shots/

# Env / secrets — API keys are stored client-side (browser), never commit any
.env
.env.local
.env.*.local
*.local

# Editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Test coverage
coverage/

# Security-scan artifacts (scripts/security-scan.sh writes reports/SBOM here).
# The policy/ruleset files under .security/ ARE committed; only the run output is not.
.security/out/

# Typst / WASM build artifacts (if vendored locally)
*.wasm.tmp

# Local Claude Code session / scheduler state (never commit)
.claude/
.superpowers/

# Internal process docs (build history, methodology, wave logs) — kept on disk
# for local work, never published. Domain docs + ADRs stay in docs/.
internal/
