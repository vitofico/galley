{
  "name": "@galley/agent-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Headless draft-publisher client: join a shared project room as an agent peer and park UNSIGNED proposals in the mailbox behind the browser's manual Accept gate — connect, publish, flush, disconnect.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:surface": "node scripts/check-surface.mjs",
    "bundle": "node scripts/bundle.mjs"
  },
  "dependencies": {
    "@galley/collab": "workspace:*",
    "@galley/shared": "workspace:*",
    "lib0": "^0.2.117",
    "ws": "^8.18.0",
    "y-protocols": "^1.0.6",
    "yjs": "^13.6.0"
  },
  "devDependencies": {
    "@types/node": "^20.16.0",
    "@types/ws": "^8.5.0",
    "esbuild": "0.28.1"
  }
}
